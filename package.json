{
  "name": "obsidian-plugin-track-record",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Time tracking & status history for your notes.",
  "license": "MIT",
  "author": "Michael J. Stallinger",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "format": "node scripts/format.mjs",
    "format:check": "node scripts/check-format.mjs",
    "test": "node scripts/test.mjs",
    "check": "npm run typecheck && npm run format:check && npm run build && npm test",
    "deploy": "npm run check && node scripts/deploy.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "0.28.2",
    "obsidian": "1.14.4",
    "typescript": "^5.9.0",
    "yaml": "2.9.1"
  }
}
